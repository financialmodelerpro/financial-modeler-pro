# ─────────────────────────────────────────────────
# REFM Pro — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────

# ── Anthropic / Claude AI ────────────────────────
# Read in exactly ONE place: src/shared/ai/client.ts. No feature reads it directly.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Overrides DEFAULT_AI_MODEL in src/shared/ai/models.ts so the model
# can change without a code change. Leave unset to use the built-in default.
ANTHROPIC_MODEL=

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── NextAuth ──────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=https://financialmodelerpro.com

# ── Email — Brevo ────────────────────────────────
# Brevo API key — get from app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-...
# Sender addresses (must be verified in Brevo Senders & IP settings)
EMAIL_FROM_TRAINING=training@financialmodelerpro.com
EMAIL_FROM_NOREPLY=no-reply@financialmodelerpro.com
EMAIL_FROM_SUPPORT=support@financialmodelerpro.com

# ── Public (client-safe) vars ────────────────────
# Subdomain URLs — set per-domain in Vercel dashboard
# Local dev: set all three to http://localhost:3000
NEXT_PUBLIC_MAIN_URL=https://financialmodelerpro.com
NEXT_PUBLIC_LEARN_URL=https://learn.financialmodelerpro.com
NEXT_PUBLIC_APP_URL=https://app.financialmodelerpro.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
